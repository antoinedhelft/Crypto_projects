# Postgres superuser (for cluster init)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# Application database (used by API/ML/Airflow metadata)
DB_HOST=postgres
DB_PORT=5432
DB_USER=crypto
DB_PASSWORD=crypto
DB_NAME=crypto_trading

# Airflow DB name (metadata)
AIRFLOW_DB_NAME=airflow_meta

# Airflow admin user (UI login)
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_EMAIL=admin@example.com

# Airflow security
AIRFLOW_SECRET_KEY= coller la clé secrète ici
AIRFLOW_FERNET_KEY= coller la clé fernet ici

# Pour les tests E2E locaux (depuis Windows vers Docker sur localhost)
# Décommentez cette ligne si vous lancez les tests depuis votre machine Windows
# DB_HOST_TEST=localhost