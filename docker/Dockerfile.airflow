FROM apache/airflow:2.9.2-python3.12

USER root
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
RUN apt-get update && \
    apt-get install -y --no-install-recommends libgomp1 && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /opt/airflow/repo
COPY pyproject.toml uv.lock /opt/airflow/repo/
RUN python -c "import tomllib, pathlib; p = pathlib.Path('/opt/airflow/repo/pyproject.toml'); d = tomllib.loads(p.read_text(encoding='utf-8')); reqs = d['dependency-groups']['airflow']; pathlib.Path('/tmp/req.txt').write_text('\n'.join(reqs) + '\n', encoding='utf-8')" \
    && uv pip install --system --no-cache -r /tmp/req.txt

USER airflow
ENV PATH="/home/airflow/.local/bin:$PATH"
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
ENV PYTHONPATH=/opt/airflow/repo

